# Larpfit — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
#
# Solo estas variables son públicas (llegan al navegador).
# La service_role key de Supabase NUNCA va aquí ni en ningún archivo con
# prefijo NEXT_PUBLIC_.

# -----------------------------------------------------------------------------
# Supabase — Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# TURN (opcional, pero necesario para llegar al 100% de los usuarios)
# -----------------------------------------------------------------------------
# Sin TURN, quien esté tras NAT simétrico (muchas redes móviles y corporativas)
# no conectará nunca: verá "Conexión de red fallida". STUN se usa siempre y
# primero; TURN solo entra cuando STUN no consigue una ruta directa.
#
# Las tres variables deben estar completas: si falta el usuario o la credencial,
# el TURN se ignora y se avisa por consola.
#
# ⚠️ Al ser NEXT_PUBLIC_*, la credencial viaja al navegador en texto plano y
# cualquiera puede extraerla del bundle y gastar tu ancho de banda. Para
# producción, genera credenciales efímeras firmadas en el servidor (coturn con
# `use-auth-secret` + HMAC con caducidad) en vez de una credencial estática.

# Separadas por comas. Ej: turn:turn.midominio.com:3478,turns:turn.midominio.com:5349
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
