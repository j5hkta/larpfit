# Larpfit — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
#
# Regla: solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# Todo lo demás se queda en el servidor. La service_role key de Supabase y el
# secreto del TURN NUNCA llevan ese prefijo.

# -----------------------------------------------------------------------------
# Supabase (públicas) — Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# TURN — Metered (SOLO SERVIDOR)
# -----------------------------------------------------------------------------
# Sin TURN, quien esté tras NAT simétrico (muchas redes móviles y corporativas)
# no conectará nunca. STUN se usa siempre y primero; TURN solo entra cuando no
# hay ruta directa posible.
#
# La secretKey NO viaja al navegador. /api/turn autentica la sesión, pide a
# Metered una credencial con caducidad (POST /api/v1/turn/credential) y solo
# devuelve al cliente el usuario y la contraseña temporales.
#
# Si Metered no responde o falta configuración, el endpoint degrada a STUN en
# vez de romper el duelo.

# URL de TU aplicación en Metered, con el subdominio propio.
# Lo encuentras en el panel de Metered. NO es la URL del relay.
# Ej: https://larpfit.metered.live
TURN_API_URL=

# Secret Key del proyecto en Metered. Trátala como una contraseña.
TURN_SECRET=

# Opcional. URLs del relay separadas por comas. Si las pones, se compone la
# configuración ICE aquí mismo y se ahorra una llamada a Metered. Si las dejas
# vacías, se le piden a Metered con el apiKey de la credencial.
# Ej: stun:stun.relay.metered.ca:80,turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443
TURN_URLS=

# Opcional. Caducidad de las credenciales en segundos (por defecto 3600, tope 86400).
TURN_TTL_SECONDS=
