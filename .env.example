# Larpfit — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
#
# Regla: solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# Todo lo demás se queda en el servidor. La service_role key de Supabase y el
# secreto del TURN NUNCA llevan ese prefijo.

# -----------------------------------------------------------------------------
# Supabase (públicas) — Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# TURN (SOLO SERVIDOR)
# -----------------------------------------------------------------------------
# Sin TURN, quien esté tras NAT simétrico (muchas redes móviles y corporativas)
# no conectará nunca. STUN se usa siempre y primero; TURN solo entra cuando no
# hay ruta directa posible.
#
# El secreto NO viaja al navegador. /api/turn autentica la sesión y firma
# credenciales efímeras (esquema REST de coturn, `use-auth-secret`): el cliente
# recibe un usuario/credencial que caduca en minutos y no sirve para nada más.
#
# En el servidor TURN (coturn) hace falta:
#   use-auth-secret
#   static-auth-secret=<el mismo valor que TURN_SECRET>
#   realm=<tu dominio>
#
# Si tu proveedor no usa este esquema (Twilio, Cloudflare, Metered…) dímelo:
# la llamada a su API REST va en app/api/turn/route.ts.

# Separadas por comas. Ej: turn:turn.midominio.com:3478,turns:turn.midominio.com:5349
TURN_URLS=

# Secreto compartido con el servidor TURN. Trátalo como una contraseña.
TURN_SECRET=

# Opcional. Caducidad de las credenciales en segundos (por defecto 600).
TURN_TTL_SECONDS=
